{
  "name": "@bansos/contracts",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "compile": "hardhat compile",
    "export:abi": "hardhat run scripts/export-abi.ts",
    "test": "hardhat test",
    "test:abi": "hardhat test test/abi-compat.test.ts",
    "typecheck": "tsc --noEmit",
    "coverage": "COVERAGE=true hardhat coverage && ts-node scripts/check-coverage.ts",
    "gas": "REPORT_GAS=true hardhat test",
    "lint": "solhint --max-warnings 0 'contracts/**/*.sol'",
    "reports:archive": "bash scripts/archive-reports.sh",
    "slither": "slither . --config-file slither.config.json",
    "check": "pnpm compile && pnpm typecheck && pnpm test && pnpm coverage && pnpm gas && pnpm compile --force && pnpm lint && pnpm slither",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:besu": "hardhat run scripts/deploy.ts --network besu"
  },
  "dependencies": { "@openzeppelin/contracts": "5.4.0" },
  "devDependencies": {
    "hardhat": "2.28.0",
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-network-helpers": "1.1.0",
    "@nomicfoundation/hardhat-verify": "2.1.0",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.14",
    "@typechain/hardhat": "9.1.0",
    "@typechain/ethers-v6": "0.5.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.30",
    "chai": "4.5.0",
    "ethers": "6.14.4",
    "hardhat-gas-reporter": "2.3.0",
    "solidity-coverage": "0.8.16",
    "solhint": "5.0.5",
    "solc": "0.8.28",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.7.3"
  }
}
