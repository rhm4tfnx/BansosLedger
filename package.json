{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsx scripts/lint.ts",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm test:foundation && pnpm test:domain",
    "test:e2e": "playwright test",
    "db:indexes": "node --conditions=react-server --import tsx scripts/ensure-indexes.ts",
    "accounts": "node --conditions=react-server --import tsx scripts/accounts.ts",
    "docs:errors": "tsx scripts/docs-errors.ts",
    "test:foundation": "node --conditions=react-server --import tsx --test src/lib/crypto/foundation.test.ts src/lib/db/foundation.test.ts",
    "test:domain": "node --conditions=react-server --import tsx --test src/modules/domain/domain.test.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^7.0.1",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.105.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "ethers": "^6.13.5",
    "file-type": "^22.3.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.16.0",
    "mongoose": "^8.24.7",
    "next": "16.3.3",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.91.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "msw": "^3.0.3",
    "postcss": "^8.5",
    "prettier": "^3.9.10",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vitest": "^5.0.5"
  }
}
